# NSE & BSE Corporate Disclosure Radar Configuration

# ── Radar Configuration ──
POLL_INTERVAL_SECONDS=45
WATCHLIST_ONLY=True
FILTER_ROUTINE_NOISE=True

# ── WhatsApp Notification Configuration ──
# Recipient phone number (format: +919471009531)
WHATSAPP_PHONE_NUMBER=+919471009531

# Provider options: 'callmebot', 'twilio', 'meta_cloud', 'console'
WHATSAPP_PROVIDER=callmebot

# 1. CallMeBot Settings (Instant 30-sec free setup):
# Send a WhatsApp message from +919471009531 to +34 644 59 75 14 with text:
# "I allow callmebot to send me messages"
# You will get an API Key immediately. Paste it below:
CALLMEBOT_API_KEY=

# 2. Twilio WhatsApp Settings (Optional):
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# 3. Meta WhatsApp Cloud API (Optional):
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=

# ── AI / LLM Interpretation ──
# Optional Gemini or OpenAI API Key for deep LLM analysis.
# (If left blank, the built-in financial NLP rules engine automatically analyzes all disclosures!)
GEMINI_API_KEY=
OPENAI_API_KEY=

